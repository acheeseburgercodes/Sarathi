# Optional server-side AI synthesis. Never expose this value to browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
SARATHI_WEATHER_MODEL=
SARATHI_NEWS_MODEL=
SARATHI_SEISMIC_MODEL=
SARATHI_EVENTS_MODEL=
SARATHI_CLIMATE_MODEL=
SARATHI_CENTRAL_MODEL=
# Optional hard-limit overrides. Leave unset to use the selected remote/standard/deep profile.
# SARATHI_MAX_MODEL_CALLS=5
# SARATHI_MAX_INPUT_TOKENS=30000
# SARATHI_MAX_OUTPUT_TOKENS=8000
# SARATHI_MAX_TOTAL_TOKENS=38000
# SARATHI_MAX_INPUT_TOKENS_PER_CALL=8000
# SARATHI_CENTRAL_INPUT_RESERVE=6000
SARATHI_EXACT_TOKEN_COUNT=1
SARATHI_BACKEND_PORT=8765
SARATHI_BACKEND_URL=http://127.0.0.1:8765

# Supabase Data API. The secret key is backend-only and must never be committed or exposed to a browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
# Future frontend Realtime client only. Safe to expose when RLS is enabled.
SUPABASE_PUBLISHABLE_KEY=
# Use these aliases when the frontend is connected later.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only; prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Optional provider credentials. Keep blank when you have not enabled the provider.
NASA_FIRMS_API_KEY=
NEWS_API_KEY=
# Optional OpenWeather One Call supplement for current conditions and provider-carried
# government alerts. Requires an OpenWeather One Call subscription/API key.
OPENWEATHER_API_KEY=
# NASA POWER climate data is connected and does not require an API key.

# Server-side persistence and retrieval.
DATABASE_URL=
VECTOR_DATABASE_URL=
